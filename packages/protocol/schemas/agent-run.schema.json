{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ielts-speaking.local/schemas/agent-run.schema.json",
  "title": "AgentRun",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "session_id", "status", "started_at", "steps"],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "user_id_hash": {
      "type": ["string", "null"]
    },
    "mode": {
      "type": ["string", "null"],
      "enum": ["full_exam", "part_practice", "topic_practice", null]
    },
    "part": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 3
    },
    "question_id": {
      "type": ["string", "null"]
    },
    "status": {
      "type": "string",
      "enum": ["running", "completed", "failed", "cancelled"]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentStep"
      }
    },
    "stream_events": {
      "type": "array",
      "items": {
        "$ref": "agent-stream-event.schema.json"
      },
      "default": []
    }
  },
  "$defs": {
    "AgentUsageDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_creation_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_read_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "ReasoningBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "created_at"],
      "properties": {
        "block_id": { "type": "string" },
        "type": { "type": "string", "default": "reasoning" },
        "text": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "raw": true,
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "AgentStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "workflow_node", "status", "started_at"],
      "properties": {
        "step_id": {
          "type": "string"
        },
        "workflow_node": {
          "type": "string"
        },
        "part": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 3
        },
        "question_id": {
          "type": ["string", "null"]
        },
        "agent_name": {
          "type": ["string", "null"]
        },
        "prompt_version": {
          "type": ["string", "null"]
        },
        "model_name": {
          "type": ["string", "null"]
        },
        "status": {
          "type": "string",
          "enum": ["running", "completed", "failed"]
        },
        "input_summary": {
          "type": ["string", "null"]
        },
        "output_summary": {
          "type": ["string", "null"]
        },
        "input_payload": true,
        "input_detail": true,
        "output_payload": true,
        "messages": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "reasoning_blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReasoningBlock"
          },
          "default": []
        },
        "usage_detail": {
          "anyOf": [
            { "$ref": "#/$defs/AgentUsageDetail" },
            { "type": "null" }
          ]
        },
        "stream_event_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "input_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "output_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "retrieved_chunks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          },
          "default": []
        },
        "structured_output_validity": {
          "type": ["boolean", "null"]
        },
        "scoring_result": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "latency_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "error_code": {
          "type": ["string", "null"]
        },
        "error_type": {
          "type": ["string", "null"]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "default": []
        },
        "llm_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TraceLlmCall"
          },
          "default": []
        }
      }
    },
    "TraceLlmCall": {
      "type": "object",
      "additionalProperties": true,
      "required": ["llm_call_id", "call_name", "status", "started_at"],
      "properties": {
        "llm_call_id": { "type": "string" },
        "call_name": { "type": "string" },
        "agent_name": { "type": ["string", "null"] },
        "execution_kind": { "type": "string", "enum": ["llm", "deterministic", "tool"] },
        "payload_origin": { "type": "string", "enum": ["captured", "derived"] },
        "provider": { "type": ["string", "null"] },
        "model_name": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] },
        "provider_request_id": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["running", "completed", "failed"] },
        "reasoning_blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/ReasoningBlock" },
          "default": []
        },
        "usage_detail": {
          "anyOf": [
            { "$ref": "#/$defs/AgentUsageDetail" },
            { "type": "null" }
          ]
        },
        "stream_event_count": { "type": "integer", "minimum": 0, "default": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "latency_ms": { "type": ["integer", "null"], "minimum": 0 },
        "error_code": { "type": ["string", "null"] },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "ToolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "status", "latency_ms"],
      "properties": {
        "tool_name": {
          "type": "string"
        },
        "scope": {
          "type": ["string", "null"]
        },
        "status": {
          "type": "string",
          "enum": ["completed", "failed"]
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "error_code": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
