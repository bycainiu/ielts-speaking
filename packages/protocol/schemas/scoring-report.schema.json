{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ielts-speaking.local/schemas/scoring-report.schema.json",
  "title": "ScoringReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "session_id", "version", "overall_band", "confidence", "criteria", "disclaimer"],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "overall_band": {
      "$ref": "#/$defs/BandScore"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fluency_coherence",
        "lexical_resource",
        "grammatical_range_accuracy",
        "pronunciation"
      ],
      "properties": {
        "fluency_coherence": {
          "$ref": "#/$defs/CriterionScore"
        },
        "lexical_resource": {
          "$ref": "#/$defs/CriterionScore"
        },
        "grammatical_range_accuracy": {
          "$ref": "#/$defs/CriterionScore"
        },
        "pronunciation": {
          "$ref": "#/$defs/CriterionScore"
        }
      }
    },
    "reviewer_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "next_practice_plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PracticeItem"
      },
      "default": []
    },
    "disclaimer": {
      "type": "string",
      "const": "AI 模拟评分仅用于练习参考，不代表 IELTS 官方成绩。"
    }
  },
  "$defs": {
    "BandScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 9,
      "multipleOf": 0.5
    },
    "CriterionScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band", "confidence", "evidence", "suggestions"],
      "properties": {
        "band": {
          "$ref": "#/$defs/BandScore"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "quote", "reason"],
      "properties": {
        "turn_id": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "PracticeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "focus", "task"],
      "properties": {
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "focus": {
          "type": "string"
        },
        "task": {
          "type": "string"
        }
      }
    }
  }
}
