# Staging profile
APP_ENV=staging
LOG_LEVEL=info

# Public URLs
STAGING_WEB_URL=https://staging.example.com
NEXT_PUBLIC_API_BASE_URL=https://staging-api.example.com
NEXT_PUBLIC_AGENT_EVENT_SOURCE=websocket
S3_PUBLIC_ENDPOINT=https://staging-minio.example.com
AGENT_HARNESS_PUBLIC_URL=https://staging-agent.example.com
AGENT_HARNESS_URL=http://agent-harness:8000
SPEECH_ASSESSMENT_PUBLIC_URL=https://staging-speech.example.com

# Service ports
WEB_PORT=3000
API_HOST_PORT=18080
API_HTTP_PORT=8080
AGENT_HTTP_PORT=8000
SPEECH_ASSESSMENT_PORT=8010

# Database / cache
POSTGRES_DB=ielts_speaking
POSTGRES_USER=ielts
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgres://ielts:change-me@postgres:5432/ielts_speaking?sslmode=disable
REDIS_URL=redis://redis:6379/0

# Storage
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=ielts-speaking-staging
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_REGION=local
S3_USE_SSL=false

# Security
JWT_SECRET=replace-with-strong-staging-secret-at-least-32-chars
TRACE_USER_HASH_SALT=replace-with-staging-trace-salt

# Model gateway
MOCK_MODEL_ENABLED=false
MIMO_API_KEY=replace-with-staging-key
MIMO_BASE_URL=https://api.mimo.example/v1
MIMO_DEFAULT_MODEL=mimo-v2.5-pro
MIMO_API_FORMAT=anthropic
MIMO_INPUT_COST_USD_PER_1K_TOKENS=0
MIMO_OUTPUT_COST_USD_PER_1K_TOKENS=0

# Speech evidence layer
SPEECH_ASSESSMENT_URL=http://speech-assessment:8010
SPEECH_ASSESSMENT_MODE=deterministic
SPEECH_ASR_TIMESTAMP_PROVIDER=deterministic
FASTER_WHISPER_MODEL_SIZE=tiny
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8

# Observability
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
LANGFUSE_HOST=https://langfuse.example.com
