# Global
APP_ENV=local
LOG_LEVEL=info

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_AGENT_EVENT_SOURCE=websocket

# Go API
API_HTTP_PORT=8080
DATABASE_URL=postgres://ielts:ielts@postgres:5432/ielts_speaking?sslmode=disable
REDIS_URL=redis://redis:6379/0
JWT_SECRET=local-dev-change-me-minimum-32-chars
AGENT_HARNESS_URL=http://agent-harness:8000

# Agent Harness
AGENT_HTTP_PORT=8000
MOCK_MODEL_ENABLED=true
MIMO_API_KEY=change-me
MIMO_BASE_URL=https://api.mimo.example/v1
MIMO_DEFAULT_MODEL=mimo-v2.5-pro
MIMO_API_FORMAT=openai
MIMO_TIMEOUT_SECONDS=30
MIMO_MAX_RETRIES=2
MIMO_MODEL_ROUTES_JSON={}
MIMO_INPUT_COST_USD_PER_1K_TOKENS=0
MIMO_OUTPUT_COST_USD_PER_1K_TOKENS=0
MIMO_AVAILABLE_MODELS_JSON=["mimo-v2.5-pro","mimo-v2.5","mimo-v2.5-asr","mimo-v2.5-tts-voiceclone","mimo-v2.5-tts-voicedesign","mimo-v2.5-tts","mimo-v2-pro","mimo-v2-omni","mimo-v2-tts"]

# Knowledge / RAG
KNOWLEDGE_STORE_BACKEND=memory
KNOWLEDGE_DATABASE_URL=postgres://ielts:ielts@postgres:5432/ielts_speaking?sslmode=disable
KNOWLEDGE_EMBEDDING_MODEL=hash-embedding-v1
KNOWLEDGE_EMBEDDING_DIMENSION=1536
KNOWLEDGE_CHUNK_MAX_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP_CHARS=120

# PostgreSQL / pgvector
POSTGRES_DB=ielts_speaking
POSTGRES_USER=ielts
POSTGRES_PASSWORD=ielts
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=ielts-speaking-local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=local
S3_USE_SSL=false
AUDIO_MAX_UPLOAD_BYTES=26214400
AUDIO_MAX_DURATION_MS=600000

# Observability
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_TIMEOUT_SECONDS=3
TRACE_USER_HASH_SALT=local-trace-salt-change-me
TRACE_STORE_LIMIT=500
OBSERVABILITY_ERROR_RATE_ALERT_THRESHOLD=0.1
OBSERVABILITY_LATENCY_P95_ALERT_MS=5000

# Speech Assessment
SPEECH_ASSESSMENT_PORT=8010
SPEECH_ASSESSMENT_URL=http://speech-assessment:8010
SPEECH_ASSESSMENT_MODE=deterministic
SPEECH_ASR_TIMESTAMP_PROVIDER=deterministic
FASTER_WHISPER_MODEL_SIZE=tiny
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
